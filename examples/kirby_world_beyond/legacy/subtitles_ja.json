[
  {
    "id": 1,
    "time": "00:00:00,000 --> 00:00:02,100",
    "ja": "わっ、あーわっはーわっはーわー"
  },
  {
    "id": 2,
    "time": "00:00:02,160 --> 00:00:06,910",
    "ja": "た!来ましたよ!やつの周来です!"
  },
  {
    "id": 3,
    "time": "00:00:07,110 --> 00:00:09,290",
    "ja": "星のカビー、感転進削"
  },
  {
    "id": 4,
    "time": "00:00:09,310 --> 00:00:11,730",
    "ja": "その名も、星のカビー、ワールドビヨンド"
  },
  {
    "id": 5,
    "time": "00:00:11,730 --> 00:00:14,290",
    "ja": "やったー、スイッチ、ツーカビー3本目だー"
  },
  {
    "id": 6,
    "time": "00:00:14,290 --> 00:00:15,150",
    "ja": "早いなー"
  },
  {
    "id": 7,
    "time": "00:00:15,150 --> 00:00:17,670",
    "ja": "実的にそろそろ来るだろうとは思っていましたが"
  },
  {
    "id": 8,
    "time": "00:00:17,670 --> 00:00:19,770",
    "ja": "まさか忍題のお取りに持ってくるなんて"
  },
  {
    "id": 9,
    "time": "00:00:19,770 --> 00:00:21,610",
    "ja": "ディスカバリーがカッコイイチ売れたから"
  },
  {
    "id": 10,
    "time": "00:00:21,610 --> 00:00:24,290",
    "ja": "ニンテン動画はモビッグタイトル急に扱ってくれてる"
  },
  {
    "id": 11,
    "time": "00:00:24,290 --> 00:00:26,310",
    "ja": "それに来年は35周年だし"
  },
  {
    "id": 12,
    "time": "00:00:26,390 --> 00:00:29,590",
    "ja": "ここでドンと構してカビーを盛り上げたいって言う意向を感じるよ"
  },
  {
    "id": 13,
    "time": "00:00:29,590 --> 00:00:35,110",
    "ja": "これからは時をかにメトロイドにメタすらまで待ってますからね。このチャンネルが急がしすぎて嬉しいにそうです。"
  },
  {
    "id": 14,
    "time": "00:00:35,110 --> 00:00:41,190",
    "ja": "というわけで今回は、星のカービー・ワールド・ビヨンドの処方PVを見ながら、気づいたことを適当にくっちゃべっていきます。"
  },
  {
    "id": 15,
    "time": "00:00:49,500 --> 00:00:53,980",
    "ja": "星のカービー・ワールド・ビヨンドは、シリーズ39作目にあたる本編新作です。"
  },
  {
    "id": 16,
    "time": "00:00:53,980 --> 00:00:57,100",
    "ja": "ワールドは世界、ビヨンドは超える、つまり世界を超える?"
  },
  {
    "id": 17,
    "time": "00:00:57,100 --> 00:01:01,700",
    "ja": "世界の壁をぶち破って一体どこへ行こうと言うんだ。タイトルから謎が深まるばかりだ。"
  },
  {
    "id": 18,
    "time": "00:01:01,700 --> 00:01:03,820",
    "ja": "一部でシャドバって言われて手笑いました。"
  },
  {
    "id": 19,
    "time": "00:01:03,820 --> 00:01:05,460",
    "ja": "役所は何がいいですかね?"
  },
  {
    "id": 20,
    "time": "00:01:05,460 --> 00:01:10,700",
    "ja": "WB、ワード、ワビヨ、ワン、ドド、DD、ワー、普通にWBが呼びやすそう。"
  },
  {
    "id": 21,
    "time": "00:01:10,700 --> 00:01:13,140",
    "ja": "発売時期は2027年の春だそう。"
  },
  {
    "id": 22,
    "time": "00:01:13,140 --> 00:01:17,500",
    "ja": "早、この書き方はディスカバリー処方の時と同じですね。その流れで行くと、"
  },
  {
    "id": 23,
    "time": "00:01:17,500 --> 00:01:20,460",
    "ja": "2027年3月発売が一番濃厚です。"
  },
  {
    "id": 24,
    "time": "00:01:20,460 --> 00:01:26,260",
    "ja": "次に4月か、カービーって3月発売の作品がめちゃくちゃ多いよね。今回もその流れにならってそう。"
  },
  {
    "id": 25,
    "time": "00:01:26,260 --> 00:01:29,140",
    "ja": "お願いだから4月のFF7とかぶらないでほしい。"
  },
  {
    "id": 26,
    "time": "00:01:29,140 --> 00:01:32,980",
    "ja": "見た限りのゲーム内容は、ディスカバリーを継承した3Dアクションです。"
  },
  {
    "id": 27,
    "time": "00:01:32,980 --> 00:01:37,020",
    "ja": "おなじみカービーが走って飛んで吸い込みして、コピー能力も現在なようです。"
  },
  {
    "id": 28,
    "time": "00:01:37,020 --> 00:01:40,260",
    "ja": "しかし、なんか明らかにいつもと違うところがありますよね?"
  },
  {
    "id": 29,
    "time": "00:01:40,260 --> 00:01:44,340",
    "ja": "ビールドが広い、こんなにも広大な世界はディスカバリーの時ですらなかった。"
  },
  {
    "id": 30,
    "time": "00:01:44,340 --> 00:01:45,980",
    "ja": "これはもしかしてもしかすると。"
  },
  {
    "id": 31,
    "time": "00:01:45,980 --> 00:01:49,420",
    "ja": "そのまさか、カービーが遂にオープンワールドへ挑戦したのかも。"
  },
  {
    "id": 32,
    "time": "00:01:49,420 --> 00:01:53,340",
    "ja": "マジかー。最近はマリオ・モソニックもこのジャンルに挑戦してる。"
  },
  {
    "id": 33,
    "time": "00:01:53,340 --> 00:01:56,620",
    "ja": "古くから続くアクションゲームシリーズの新たな到達点だった。"
  },
  {
    "id": 34,
    "time": "00:01:56,620 --> 00:02:01,340",
    "ja": "まさかその領域に、我らのカービーちゃんが踏み込むなんて、全くの予想外だったわ。"
  },
  {
    "id": 35,
    "time": "00:02:01,340 --> 00:02:02,980",
    "ja": "いい意味で予想を裏切られました。"
  },
  {
    "id": 36,
    "time": "00:02:02,980 --> 00:02:08,660",
    "ja": "てっきり見実に、ディスカバリー予選のステージクリア型3Dアクション2本目が来るんだとばかり思ってました。"
  },
  {
    "id": 37,
    "time": "00:02:08,660 --> 00:02:11,260",
    "ja": "オープンワールドのカービーはまだ当分先だろうな。"
  },
  {
    "id": 38,
    "time": "00:02:11,260 --> 00:02:12,460",
    "ja": "手を持ってたら早い。"
  },
  {
    "id": 39,
    "time": "00:02:12,460 --> 00:02:15,460",
    "ja": "あまりにも早すぎた進化、範の夢がもう叶っちゃう。"
  },
  {
    "id": 40,
    "time": "00:02:15,460 --> 00:02:18,300",
    "ja": "来年の今頃には既に遊び終わった状態ですよ。"
  },
  {
    "id": 41,
    "time": "00:02:18,300 --> 00:02:21,740",
    "ja": "クッププランドの広大なフィールドを、シームレスに自由に走り回れる。"
  },
  {
    "id": 42,
    "time": "00:02:21,740 --> 00:02:23,780",
    "ja": "そんなゲームをみんな妄想してたはず。"
  },
  {
    "id": 43,
    "time": "00:02:23,780 --> 00:02:28,580",
    "ja": "これをついに実現したのか、ハルケンさん相変わらずのカービーアイト技術力で攻めますなぁ。"
  },
  {
    "id": 44,
    "time": "00:02:28,580 --> 00:02:33,540",
    "ja": "ディスカバリーが出た時も衝撃がすごかったのに、まさかそれ以上のインタクトをもう味わえるなんて、"
  },
  {
    "id": 45,
    "time": "00:02:33,540 --> 00:02:42,730",
    "ja": "毎回思うけど自作どうするんだ?って思わせてから最高傑作更新が早い、今回もその予感しかしない。"
  },
  {
    "id": 46,
    "time": "00:02:42,730 --> 00:02:45,290",
    "ja": "とりあえずPVを細かく見返していきましょうか。"
  },
  {
    "id": 47,
    "time": "00:02:45,290 --> 00:02:49,450",
    "ja": "まず最初に打つったこの景色から即カービーだと誰もが理解できるかと思います。"
  },
  {
    "id": 48,
    "time": "00:02:49,450 --> 00:02:52,330",
    "ja": "これはハルケン側もあえて狙ってやってるんだと思います。"
  },
  {
    "id": 49,
    "time": "00:02:52,330 --> 00:02:58,570",
    "ja": "Vのクッキーカントリーの背景にあった、風車のような台北、チーズのような岩屋滝も、動作品のものからです。"
  },
  {
    "id": 50,
    "time": "00:02:58,570 --> 00:03:03,210",
    "ja": "そしてスターライズのグリーングリーティングなどの背景の、バーム空編みたいな地形もあります。"
  },
  {
    "id": 51,
    "time": "00:03:03,210 --> 00:03:07,690",
    "ja": "次のカットではシリーズお馴染みの、アレや、いつものカービーハウスも発見できます。"
  },
  {
    "id": 52,
    "time": "00:03:07,690 --> 00:03:10,290",
    "ja": "ただかコサッと違って窓がないのは気になります。"
  },
  {
    "id": 53,
    "time": "00:03:10,290 --> 00:03:11,530",
    "ja": "部屋めっちゃ暗そう。"
  },
  {
    "id": 54,
    "time": "00:03:11,530 --> 00:03:17,570",
    "ja": "別のカットでは、スーパーデラックスのキャンディー山っぽい、というか開発元がある山無しの富士山っぽい山も確認。"
  },
  {
    "id": 55,
    "time": "00:03:17,570 --> 00:03:19,850",
    "ja": "星の模様が付いたデッパリ第一もあります。"
  },
  {
    "id": 56,
    "time": "00:03:19,850 --> 00:03:22,970",
    "ja": "デザインはSDXというよりUSDXっぽいかな。"
  },
  {
    "id": 57,
    "time": "00:03:22,970 --> 00:03:30,810",
    "ja": "PV内のBGMをよく聞くと、4人の仲間とクッキーカントリーのフレーズがサラッと入り、その後にお馴染みグリーングリーンズ新アレンジが流れます。"
  },
  {
    "id": 58,
    "time": "00:03:30,810 --> 00:03:34,290",
    "ja": "このアレンジはディスカバリー版、ただいまカービーに少し近かったですね。"
  },
  {
    "id": 59,
    "time": "00:03:34,290 --> 00:03:42,290",
    "ja": "後半のメロディークズスパートとか特に、これらがコサクで見た景色を赤さまに見せつけることで、視聴者が0.5秒でカービーだと魂で理解します。"
  },
  {
    "id": 60,
    "time": "00:03:42,290 --> 00:03:50,490",
    "ja": "ディスカバリー処方の時は、後輩した文明のコンセプトいう、カービーっぽくない景色を先に見せてから、カービーのゲームですよって後から伝える構成だったよね。"
  },
  {
    "id": 61,
    "time": "00:03:50,490 --> 00:03:56,570",
    "ja": "今回はその逆をやってるのか、おなじみの景色を先に見せた後に、全く新たな世界の向こう側へ超えてゆく。"
  },
  {
    "id": 62,
    "time": "00:03:56,570 --> 00:04:01,690",
    "ja": "過去作の景色を超えて新たな世界へ、今作はこれをコンセプトに作られているのかもしれません。"
  },
  {
    "id": 63,
    "time": "00:04:01,690 --> 00:04:16,050",
    "ja": "グリーン・グリーディングとクッキー・カントリーが融合した、いつものカービーっぽい平原ステージがあるように、フロートアイランズの海やバブリークラウズの空など、過去作ステージがフル3Dでリメイクされ、それをスーパー能力もどきでぶち破った先に、あと驚かされる道なる世界が待っている。"
  },
  {
    "id": 64,
    "time": "00:04:16,050 --> 00:04:20,170",
    "ja": "もしこの流れでゲーム進行していくのだとすれば、めちゃくちゃワクワクしますよ。"
  },
  {
    "id": 65,
    "time": "00:04:20,170 --> 00:04:26,170",
    "ja": "あのステージたちを3Dで遊んでみたいっていうファンの欲求が叶うし、35周年記念タイトルとしてもふさわしい。"
  },
  {
    "id": 66,
    "time": "00:04:26,170 --> 00:04:31,290",
    "ja": "そして全く新たな世界を壁の向こう側に隠すことで、新鮮なワクワクを演出してくれそう。"
  },
  {
    "id": 67,
    "time": "00:04:31,290 --> 00:04:35,610",
    "ja": "でちょっと気になったのが、カービーの家の横にある地球儀ならぬボックスター儀です。"
  },
  {
    "id": 68,
    "time": "00:04:35,610 --> 00:04:43,970",
    "ja": "はい、これなんなんでしょうね。マリオでっせいの船の地球儀っぽいですけど、イメージ的にはワールドマップを開いたり、アストトラベルを行えるポイントって感じなのかな?"
  },
  {
    "id": 69,
    "time": "00:04:43,970 --> 00:04:49,210",
    "ja": "このボックスター儀に触れておけば、いつでもそこへワープできる的な、もちろんワークスターに乗っていどう。"
  },
  {
    "id": 70,
    "time": "00:04:49,210 --> 00:04:52,850",
    "ja": "テンマップを統括した何かしらの機能を持たせているっぽいですよね。"
  },
  {
    "id": 71,
    "time": "00:04:52,850 --> 00:04:56,010",
    "ja": "ここからさっすぐに、今回の舞台はボックスターなんでしょう。"
  },
  {
    "id": 72,
    "time": "00:04:56,010 --> 00:05:01,890",
    "ja": "最近は宇宙や新世界に行ってて、故郷をルスにしてたけれど、今回はボックスター本堂駆け舞われるのかな?"
  },
  {
    "id": 73,
    "time": "00:05:01,890 --> 00:05:05,450",
    "ja": "どっち道3Dでは新鮮だからマンガリかんないよ。"
  },
  {
    "id": 74,
    "time": "00:05:05,450 --> 00:05:09,610",
    "ja": "ここはおそらく一面、ブレワイでいう始まりの大地ポジションなのかと思われます。"
  },
  {
    "id": 75,
    "time": "00:05:09,610 --> 00:05:13,090",
    "ja": "フィールドがひっどい、これどこからどう走ればいいのか迷っちゃうかも。"
  },
  {
    "id": 76,
    "time": "00:05:13,090 --> 00:05:17,670",
    "ja": "メインルートにはしばふがなかったり、走やさくで進むべき道を誘導しているように見えます。"
  },
  {
    "id": 77,
    "time": "00:05:17,670 --> 00:05:20,550",
    "ja": "でもだからといって他の場所へ進めないわけでもなさそう。"
  },
  {
    "id": 78,
    "time": "00:05:20,550 --> 00:05:23,150",
    "ja": "寄り道したければいくらでも道を外せそうです。"
  },
  {
    "id": 79,
    "time": "00:05:23,150 --> 00:05:28,270",
    "ja": "スターラの時は背景だったマッチャバーム空間を、我が足で踏み付けられる、これだけで嬉しい。"
  },
  {
    "id": 80,
    "time": "00:05:28,270 --> 00:05:32,910",
    "ja": "キーカントリー台北の上に、橋が見えることから、あの木の上にも登れそうな感じです。"
  },
  {
    "id": 81,
    "time": "00:05:32,910 --> 00:05:38,450",
    "ja": "2Dの頃は、背景が綺麗すぎて奥にも進んでみたいっていう夢があったのですが、それかないます。"
  },
  {
    "id": 82,
    "time": "00:05:38,450 --> 00:05:44,430",
    "ja": "あたりを見渡すとスターコインや爆弾ブロックとか、なんか仕掛けがありそうで枠枠するよ、寄り道が止まらなさそう。"
  },
  {
    "id": 83,
    "time": "00:05:44,430 --> 00:05:48,550",
    "ja": "カメラワークもちょっと変わってますね。ファット見た感じ固定カメラではないっぽい?"
  },
  {
    "id": 84,
    "time": "00:05:48,550 --> 00:05:53,250",
    "ja": "ディスカバリーではその場所ごとに視点が固定されてて、3D初心者でも見やすかったよね。"
  },
  {
    "id": 85,
    "time": "00:05:53,250 --> 00:05:56,230",
    "ja": "でも今回はもしかして、任意でカメラ動かせるっぽい?"
  },
  {
    "id": 86,
    "time": "00:05:56,230 --> 00:05:58,410",
    "ja": "オープンワールドとの相性も良さそうだし。"
  },
  {
    "id": 87,
    "time": "00:05:58,410 --> 00:06:03,010",
    "ja": "だとしたらめっちゃ嬉しいです。グルグル動かしてカービーちゃんのご存感を自由におかめます。"
  },
  {
    "id": 88,
    "time": "00:06:03,010 --> 00:06:12,010",
    "ja": "まあPV用にカメラワークを変えてるだけの可能性もありますが、ただおそらくボス戦は、戦闘フィールドが固定され、カメラワークも前作同様の自動調整一歩組みえます。"
  },
  {
    "id": 89,
    "time": "00:06:12,010 --> 00:06:14,330",
    "ja": "ボス戦中に脱走することはできないか。"
  },
  {
    "id": 90,
    "time": "00:06:14,330 --> 00:06:18,910",
    "ja": "モーションはディスカバリーをベースに作られているようですが、一部新しいのも確認できます。"
  },
  {
    "id": 91,
    "time": "00:06:18,910 --> 00:06:24,290",
    "ja": "それがこのダッシュ、ディスカバリーのようなダッシュ移動に加えて、さらにもう一段階加速するっぽいです。"
  },
  {
    "id": 92,
    "time": "00:06:24,290 --> 00:06:30,030",
    "ja": "風邪や煙のエフェクトがさらに強調されてていいね。やっぱマップが広くなった文化速手段も増やさないと。"
  },
  {
    "id": 93,
    "time": "00:06:30,030 --> 00:06:34,710",
    "ja": "足のドタバタ感がスピードアップによりたこ足みたいに見えるの、コミカルでとても可愛いです。"
  },
  {
    "id": 94,
    "time": "00:06:34,710 --> 00:06:39,830",
    "ja": "見た目的にはスーパーでラックスのダッシュっぽいですよね。夢の泉で合わせふため、カービーにも似てる。"
  },
  {
    "id": 95,
    "time": "00:06:39,830 --> 00:06:44,170",
    "ja": "次はブリッパーが飛び跳ねる泉エリア、水面やしぶきの表現が美しすぎる。"
  },
  {
    "id": 96,
    "time": "00:06:44,170 --> 00:06:47,950",
    "ja": "ここは浅瀬だからできなさげだけど、今回は水中に潜れるのかな?"
  },
  {
    "id": 97,
    "time": "00:06:47,950 --> 00:06:53,010",
    "ja": "このシーンでジミニのじいさんが内定しています。スリープは相変わらず、デバンに愛されていますなぁ。"
  },
  {
    "id": 98,
    "time": "00:06:53,010 --> 00:06:59,790",
    "ja": "次はサーキブルさんを補食する場面。ここで気付くのはもちろん。奥の方にクソで駆けピーに囲まれたワープスター?が見えること。"
  },
  {
    "id": 99,
    "time": "00:06:59,790 --> 00:07:03,070",
    "ja": "あれはクスタなのか?なんか星が二つあるの謎なんだけど。"
  },
  {
    "id": 100,
    "time": "00:07:03,070 --> 00:07:08,230",
    "ja": "どうやら雑魚的の中には色違い巨大固体もいるようです。ちょっと手強いユニークモンスター的な?"
  },
  {
    "id": 101,
    "time": "00:07:08,230 --> 00:07:13,230",
    "ja": "そしてサーキブルを駅で溶かして吸収した際の、コピー能力ゲットモーションが一進されています。"
  },
  {
    "id": 102,
    "time": "00:07:13,230 --> 00:07:19,430",
    "ja": "フーメランを投げてキャッチ、短時間で個性を見せる演出いなぁ。これ全コピー能力分のサブンが用意されてそうです。"
  },
  {
    "id": 103,
    "time": "00:07:19,430 --> 00:07:24,930",
    "ja": "前作ではどのコピーも共通して手を上げるだけだったから、そこから演出面をさらに作り込んできたのか。"
  },
  {
    "id": 104,
    "time": "00:07:24,930 --> 00:07:33,070",
    "ja": "カッター・フーメランは前作通りの性能っぽいです。でもアドチャンが新しくなっていますね。なんかかぶととコンボを装備してる。いつもより攻撃的だね。"
  },
  {
    "id": 105,
    "time": "00:07:33,070 --> 00:07:37,570",
    "ja": "これはゼルダシリーズのボコブリンを放出とさせますよ。ブレは意識しているのでしょうか。"
  },
  {
    "id": 106,
    "time": "00:07:37,570 --> 00:07:46,410",
    "ja": "多分コンボのコピーはなさそう。普通にスカでしょ。そして次の場面では、驚きの新技を放っています。カッターの刃に乗ってカックーしてる。なんじゃそりゃー。"
  },
  {
    "id": 107,
    "time": "00:07:46,410 --> 00:07:50,170",
    "ja": "ホバリングよりも速い速度で、広大な空間を飛び回るの楽しそう。"
  },
  {
    "id": 108,
    "time": "00:07:50,170 --> 00:07:58,210",
    "ja": "もちろん攻撃判定があるので、移動と突進を兼ねています。後ろに真空波みたいなのを排出しているので、通り道にも攻撃判定が残るのかな?"
  },
  {
    "id": 109,
    "time": "00:07:58,210 --> 00:08:06,150",
    "ja": "発動中は無敵なのかどうかは不明ですが、カービー本体よりも刃の判定が、横に少し長いっぽいです。すれ違いだマニカス当てもやってるね。"
  },
  {
    "id": 110,
    "time": "00:08:06,150 --> 00:08:10,750",
    "ja": "そしてジャンプボタンで解除かな?残った刃は自動で敵のもとへ飛んでいくみたいです。"
  },
  {
    "id": 111,
    "time": "00:08:10,750 --> 00:08:17,230",
    "ja": "最後の最後まで攻撃性高くて便利な技や。かなりの大技に見えますが、発動自体は一瞬で繰り出せるっぽいです。"
  },
  {
    "id": 112,
    "time": "00:08:17,230 --> 00:08:22,870",
    "ja": "ボタン長押しでパワーを溜めるとかは、見た感じなさそう。ブーメランを投げるボタンとかぶらないようにするとしたら、"
  },
  {
    "id": 113,
    "time": "00:08:22,870 --> 00:08:30,950",
    "ja": "もしかしたら攻撃に使うボタン数が増えているのかも、まさかカッターが各空能力に生まれ変わっちゃうなんて、これウィングやジェットの立場が危うくなるのでは?"
  },
  {
    "id": 114,
    "time": "00:08:30,950 --> 00:08:34,250",
    "ja": "そうそうそんなことないはずですよ。多分ジェットくんはいますよいますよいるよね?"
  },
  {
    "id": 115,
    "time": "00:08:34,250 --> 00:08:37,610",
    "ja": "またこの開けた空間には様々なものが写っています。"
  },
  {
    "id": 116,
    "time": "00:08:37,610 --> 00:08:44,230",
    "ja": "飯を取り囲むボコルDたち、畑っぽい土や、鍵のかかったおり、高台の上にある大きな木の内部に見える橋後、"
  },
  {
    "id": 117,
    "time": "00:08:44,230 --> 00:08:48,770",
    "ja": "ベンチに酔っこらせと座るサーキブル、明らかにメインルートの目的地として目立っている、"
  },
  {
    "id": 118,
    "time": "00:08:48,770 --> 00:08:53,690",
    "ja": "巨大バウム空編、新世界からサラッと移住している、ラビルーもしくはオーラビルーくんの内定、"
  },
  {
    "id": 119,
    "time": "00:08:53,690 --> 00:08:58,430",
    "ja": "高台から見渡すだけでもいろんなディスカバリーがある、オープンワールドの楽しさってこれだよね。"
  },
  {
    "id": 120,
    "time": "00:08:58,430 --> 00:09:01,970",
    "ja": "あっちこっちへ行ってみたい場所があって、探索の手が止まらなくなる。"
  },
  {
    "id": 121,
    "time": "00:09:01,970 --> 00:09:07,170",
    "ja": "敵キャラたちもただ置かれてるってだけじゃない、生活感溢れるクププランドの住民って感じがするよ。"
  },
  {
    "id": 122,
    "time": "00:09:07,170 --> 00:09:12,070",
    "ja": "さて次は、武器のウサマツルギのコピー、いつもと同じに見えてちょっとデザインが変わってる?"
  },
  {
    "id": 123,
    "time": "00:09:12,070 --> 00:09:16,590",
    "ja": "縫い目やボタンやポンポンなどが描写され、帽子がよりリアリティ溢れる質感になっています。"
  },
  {
    "id": 124,
    "time": "00:09:16,590 --> 00:09:19,510",
    "ja": "剣の青い部分が縦に伸びてるのも地味に新しいです。"
  },
  {
    "id": 125,
    "time": "00:09:19,510 --> 00:09:25,430",
    "ja": "総度の技は3つ判明してます、100列切りに加え、ドリル総度のように剣を吹き出しながら走る技も、"
  },
  {
    "id": 126,
    "time": "00:09:25,430 --> 00:09:30,370",
    "ja": "今までは真っ直ぐ正面に突進するだけだけど、今回はダッシュ中にも自由に移動できるっぽい。"
  },
  {
    "id": 127,
    "time": "00:09:30,370 --> 00:09:34,990",
    "ja": "ていうかさっき見た新ダッシュを総度の状態で行うと、これが繰り出せるのかもしれません。"
  },
  {
    "id": 128,
    "time": "00:09:34,990 --> 00:09:37,710",
    "ja": "そして意外な新技として、木の堀を覚えました。"
  },
  {
    "id": 129,
    "time": "00:09:37,710 --> 00:09:39,910",
    "ja": "えええええ、気にそんなことできたのかよ。"
  },
  {
    "id": 130,
    "time": "00:09:39,910 --> 00:09:45,850",
    "ja": "伝作ではあまりなかった、縦方向への移動にアプローチしてくるとは、これで探索範囲がさらに広がりました。"
  },
  {
    "id": 131,
    "time": "00:09:45,850 --> 00:09:47,870",
    "ja": "その辺に生えてる気は全部登れそう。"
  },
  {
    "id": 132,
    "time": "00:09:47,870 --> 00:09:54,230",
    "ja": "交渉へのアクセスに便利。しかし剣が突きさせない壁もありそうなので、ブレワイのようにどこでも登れるわけではなさそうです。"
  },
  {
    "id": 133,
    "time": "00:09:54,230 --> 00:09:57,370",
    "ja": "せかきの上に新しいアイテムあるんだけど、これなんだろう。"
  },
  {
    "id": 134,
    "time": "00:09:57,370 --> 00:10:02,150",
    "ja": "見た感じ石板に見えますよね?何かしらのテキストが書かれてる読み物かもしれません。"
  },
  {
    "id": 135,
    "time": "00:10:02,150 --> 00:10:05,310",
    "ja": "ストーリーを読み進めて深掘りできるの収集アイテムなのかも?"
  },
  {
    "id": 136,
    "time": "00:10:05,310 --> 00:10:10,970",
    "ja": "今回はエジプト文明がもちっぽく感じるふしもあるので、それに合わせた古代の解読資料なのかも。"
  },
  {
    "id": 137,
    "time": "00:10:10,970 --> 00:10:14,610",
    "ja": "次の場面ではボマーが映っています。よく見るとデザイン変わってます。"
  },
  {
    "id": 138,
    "time": "00:10:14,610 --> 00:10:17,990",
    "ja": "おでこの黄色いダイヤマークから、4つの突起物が生えています。"
  },
  {
    "id": 139,
    "time": "00:10:17,990 --> 00:10:22,330",
    "ja": "クラッカーボウシの柄も変更だ。緑と黄色が弱になってて、縁取りもある。"
  },
  {
    "id": 140,
    "time": "00:10:22,330 --> 00:10:26,610",
    "ja": "そして見たことのない技を披露しています。爆弾を投げる時代はもう終わりました。"
  },
  {
    "id": 141,
    "time": "00:10:26,610 --> 00:10:30,110",
    "ja": "まさかの玉頃で遊んでる、爆発物でなんて危険なことを。"
  },
  {
    "id": 142,
    "time": "00:10:30,110 --> 00:10:33,410",
    "ja": "リックストーンみたいでいいですね。爆弾玉乗りで転がります。"
  },
  {
    "id": 143,
    "time": "00:10:33,410 --> 00:10:38,330",
    "ja": "よくよく考えればポピーが玉乗りしてたので、コピー元のスキルをしっかり反映したとも取れます。"
  },
  {
    "id": 144,
    "time": "00:10:38,330 --> 00:10:42,470",
    "ja": "もしかしたらボムのダッシュ技がこれなのかもね。弾殺しながら早く進める。"
  },
  {
    "id": 145,
    "time": "00:10:42,470 --> 00:10:45,130",
    "ja": "そしてダッシュを解除すると、ボムを蹴り飛ばします。"
  },
  {
    "id": 146,
    "time": "00:10:45,130 --> 00:10:47,210",
    "ja": "多分カッターのやつと同じ仕組みかな?"
  },
  {
    "id": 147,
    "time": "00:10:47,210 --> 00:10:53,150",
    "ja": "もしかしたら全コピー能力にダッシュ技が用意され、解除時にフィニッシュ攻撃が発動し、移動に役立つのかも。"
  },
  {
    "id": 148,
    "time": "00:10:53,150 --> 00:10:57,090",
    "ja": "広いオープンワールドを、コピー能力の力で快適に進めるデザインいいね。"
  },
  {
    "id": 149,
    "time": "00:10:57,090 --> 00:11:00,850",
    "ja": "さらに弾殺中に、ボムの爆風を生かしたダイジャンプもできるみたいです。"
  },
  {
    "id": 150,
    "time": "00:11:00,850 --> 00:11:04,790",
    "ja": "すげー、めっちゃ高く上昇するじゃん。これで交渉のお宝ゲットだ。"
  },
  {
    "id": 151,
    "time": "00:11:04,790 --> 00:11:06,950",
    "ja": "ハイジャンプ君はお亡くなりになられました。"
  },
  {
    "id": 152,
    "time": "00:11:06,950 --> 00:11:10,230",
    "ja": "上昇中のエフェクト的に、ツッツキ攻撃もできそうですね。"
  },
  {
    "id": 153,
    "time": "00:11:10,230 --> 00:11:15,110",
    "ja": "こういう違和壁とかはソードで登れなさそうなので、ボムジャンプを使ってくださいってことなのかも。"
  },
  {
    "id": 154,
    "time": "00:11:15,110 --> 00:11:21,090",
    "ja": "そして、3Dではバトでライライとなり、全然いつもいるのにディスカバリーにいないせいで久しぶり感が出ている能力。"
  },
  {
    "id": 155,
    "time": "00:11:21,090 --> 00:11:23,450",
    "ja": "パラソルちゃんが泣いていしました。うれしい。"
  },
  {
    "id": 156,
    "time": "00:11:23,450 --> 00:11:29,750",
    "ja": "以前は出演回数がもっとも多いコピーでしたが、ディスカバやアイアライダーに見ない程だったため、カッターに抜かれてしまいました。"
  },
  {
    "id": 157,
    "time": "00:11:29,750 --> 00:11:35,010",
    "ja": "しかしフルカブとしてのプライドがある、だから次の3D本編こそは、出演できて良かったです。"
  },
  {
    "id": 158,
    "time": "00:11:35,010 --> 00:11:38,050",
    "ja": "デザインは変わっていないように見えて実は少しだけ変更。"
  },
  {
    "id": 159,
    "time": "00:11:38,050 --> 00:11:40,710",
    "ja": "かさを開いて下の方に青い丸いのが付いています。"
  },
  {
    "id": 160,
    "time": "00:11:40,710 --> 00:11:45,310",
    "ja": "何気にかさのない層までしっかり作られてるの新鮮だ。今まではほぼ見えなかったし。"
  },
  {
    "id": 161,
    "time": "00:11:45,310 --> 00:11:49,590",
    "ja": "パラソルラッカさんに移行する瞬間、かさがひと回り大きく開くのも良いですね。"
  },
  {
    "id": 162,
    "time": "00:11:49,590 --> 00:11:52,990",
    "ja": "技は今んとこ一個の見判明、空中をふわふわ散歩します。"
  },
  {
    "id": 163,
    "time": "00:11:52,990 --> 00:11:58,650",
    "ja": "カックーならカッターでもできるじゃん何が違うの?って思ってたら、滝を不正で裏道を発見できるようです。"
  },
  {
    "id": 164,
    "time": "00:11:58,650 --> 00:12:04,470",
    "ja": "3D探索ゲームとしてふさわしい活用法を見出されてるね。滝の中へ入れるのはかさならではって感じ。"
  },
  {
    "id": 165,
    "time": "00:12:04,470 --> 00:12:06,990",
    "ja": "背景の滝には全て突撃したくなります。"
  },
  {
    "id": 166,
    "time": "00:12:06,990 --> 00:12:12,190",
    "ja": "奥へ何が隠されているのか、なんかでてマークの罪にが隠されてる、食べ物をドッサリ入れた。"
  },
  {
    "id": 167,
    "time": "00:12:12,190 --> 00:12:16,350",
    "ja": "はい、まああた食料泥棒したようです。この人、ドンペン大王も登場です。"
  },
  {
    "id": 168,
    "time": "00:12:16,350 --> 00:12:20,590",
    "ja": "デザインはディスカバっぽい顔付きでありながら体型をもう少し従来が耐え戻したもの。"
  },
  {
    "id": 169,
    "time": "00:12:20,590 --> 00:12:24,950",
    "ja": "これはミンテンドオープデイで見たものとそっくりです。先行公開されていたんですね。"
  },
  {
    "id": 170,
    "time": "00:12:24,950 --> 00:12:29,210",
    "ja": "この人いつも整形してるぞい。でも今回のデザインは割とストレート好きだ。"
  },
  {
    "id": 171,
    "time": "00:12:29,210 --> 00:12:32,510",
    "ja": "どうやら割と序盤、もしかしたら一面ボスのようにも見えます。"
  },
  {
    "id": 172,
    "time": "00:12:32,510 --> 00:12:37,350",
    "ja": "ハンマー叩き、デデデスイング、ヘッドスライディングなど、まあいつも通りの技を使ってきます。"
  },
  {
    "id": 173,
    "time": "00:12:37,350 --> 00:12:42,550",
    "ja": "デザインはデザインとほぼ一緒だね。操作感覚を思い出してもらうためのチュートリアルボスとして最適だ。"
  },
  {
    "id": 174,
    "time": "00:12:42,550 --> 00:12:47,950",
    "ja": "3Dアクションではテッドの距離感を掴む必要があるため、ウィスピーウッズでは逆に練習にならないかも。"
  },
  {
    "id": 175,
    "time": "00:12:47,950 --> 00:12:51,510",
    "ja": "そこで図体がでかくて技が当てやすく、ボスの隙もでかいからプレイヤーが避けやすく、"
  },
  {
    "id": 176,
    "time": "00:12:51,510 --> 00:12:54,430",
    "ja": "過去作的に一年ボス並みの弱さにしても問題なさそうな。"
  },
  {
    "id": 177,
    "time": "00:12:54,430 --> 00:12:58,710",
    "ja": "デデデダイオーがボスに選ばれたんじゃないでしょうか。こいつで3Dバトルになれましょう。"
  },
  {
    "id": 178,
    "time": "00:12:58,710 --> 00:13:03,870",
    "ja": "あと前作の緊急回避システムも増等してるようです。ちょっとタイミングでスローになるのも現在。"
  },
  {
    "id": 179,
    "time": "00:13:03,870 --> 00:13:08,230",
    "ja": "デデデセンの背景を見ると、太陽に詰まれた食べ物といこいの場が確認できます。"
  },
  {
    "id": 180,
    "time": "00:13:08,230 --> 00:13:12,350",
    "ja": "国民たちの食べ物で満喫してるじゃん。あのダイオーまた凝りてなかったのかー?"
  },
  {
    "id": 181,
    "time": "00:13:12,350 --> 00:13:14,750",
    "ja": "果たして今の彼がそんなことするでしょうか?"
  },
  {
    "id": 182,
    "time": "00:13:14,750 --> 00:13:18,750",
    "ja": "ダイオーは初代で改進していこう、本編では一度も悪事を働いていません。"
  },
  {
    "id": 183,
    "time": "00:13:18,750 --> 00:13:22,750",
    "ja": "確かにスターラでも食料盗みましたが、あれはジャマハートのせいなので納還。"
  },
  {
    "id": 184,
    "time": "00:13:22,750 --> 00:13:25,830",
    "ja": "今更食べ物ドロボーとかいうおろかな行為をするでしょうか?"
  },
  {
    "id": 185,
    "time": "00:13:25,830 --> 00:13:30,230",
    "ja": "確かにコンサクのダイオーの様子を見るに、何者かに操られてるって感じでもない。"
  },
  {
    "id": 186,
    "time": "00:13:30,230 --> 00:13:34,750",
    "ja": "食べ物ドロボーしたってことだけはわかるけど、彼の目的や同期が一切読めないねー。"
  },
  {
    "id": 187,
    "time": "00:13:34,750 --> 00:13:36,670",
    "ja": "まあここは後々考察しましょう。"
  },
  {
    "id": 188,
    "time": "00:13:36,670 --> 00:13:39,630",
    "ja": "そしてダイオーをしばくと、いつも通りぶっ飛んでいきました。"
  },
  {
    "id": 189,
    "time": "00:13:39,630 --> 00:13:41,830",
    "ja": "何だいつもの光景か一見落着。"
  },
  {
    "id": 190,
    "time": "00:13:41,950 --> 00:13:44,350",
    "ja": "と思ったら、壁に穴が開いてしまいます。"
  },
  {
    "id": 191,
    "time": "00:13:44,350 --> 00:13:48,030",
    "ja": "なんと後代に見えた世界の先は、張りボテのような壁だったのです。"
  },
  {
    "id": 192,
    "time": "00:13:48,030 --> 00:13:49,710",
    "ja": "一体どういうことなんだろう?"
  },
  {
    "id": 193,
    "time": "00:13:49,710 --> 00:13:52,270",
    "ja": "ここはポップスターに見えてポップスターじゃないのか?"
  },
  {
    "id": 194,
    "time": "00:13:52,270 --> 00:13:56,750",
    "ja": "実はいつ割の世界の中に閉じ込められていたんですね。まるで作り物のようです。"
  },
  {
    "id": 195,
    "time": "00:13:56,750 --> 00:14:00,390",
    "ja": "カービーさんが寝てる間に、また世界に一変が起きたのかもしれません。"
  },
  {
    "id": 196,
    "time": "00:14:00,390 --> 00:14:04,510",
    "ja": "そしてデデデダイオーが捕まえていたという、新キャラクターの女の子も出てきました。"
  },
  {
    "id": 197,
    "time": "00:14:04,510 --> 00:14:07,350",
    "ja": "リックカインクみたいな袋詰めにされちゃってかわいそう。"
  },
  {
    "id": 198,
    "time": "00:14:07,350 --> 00:14:09,190",
    "ja": "うーん、かわいいですねこれ。"
  },
  {
    "id": 199,
    "time": "00:14:09,230 --> 00:14:11,270",
    "ja": "カービーでは珍しい人間フォルムですよ。"
  },
  {
    "id": 200,
    "time": "00:14:11,270 --> 00:14:12,550",
    "ja": "足が群ばつすぎる。"
  },
  {
    "id": 201,
    "time": "00:14:12,550 --> 00:14:15,310",
    "ja": "ちゃんと人間らしい足が描かれてるキャラの貴重さよ。"
  },
  {
    "id": 202,
    "time": "00:14:15,310 --> 00:14:17,790",
    "ja": "周りはさっきの巨大バウム空編の真下っぽい。"
  },
  {
    "id": 203,
    "time": "00:14:17,790 --> 00:14:19,790",
    "ja": "ここで彼女とご対面するのかな。"
  },
  {
    "id": 204,
    "time": "00:14:19,790 --> 00:14:22,470",
    "ja": "名前も性格も目的も何もかもが不明です。"
  },
  {
    "id": 205,
    "time": "00:14:22,470 --> 00:14:25,910",
    "ja": "とりあえず今のところは、助けてくれたカービーに感謝してるっぽい。"
  },
  {
    "id": 206,
    "time": "00:14:25,910 --> 00:14:28,190",
    "ja": "白髪にWeUマークのサカサバンがつけられ、"
  },
  {
    "id": 207,
    "time": "00:14:28,190 --> 00:14:30,550",
    "ja": "ポンチョっぽい服にいがダンマークみたいなのが、"
  },
  {
    "id": 208,
    "time": "00:14:30,550 --> 00:14:33,110",
    "ja": "金の装飾品で後ろ紙まで綺麗にまとめられ、"
  },
  {
    "id": 209,
    "time": "00:14:33,110 --> 00:14:35,070",
    "ja": "そのたつまいはエジプトやギリシャなどの、"
  },
  {
    "id": 210,
    "time": "00:14:35,070 --> 00:14:37,590",
    "ja": "イニシエの王国のお姫様みたいな雰囲気です。"
  },
  {
    "id": 211,
    "time": "00:14:37,590 --> 00:14:39,550",
    "ja": "インナーカラー、スパッツ、タイツとか言う、"
  },
  {
    "id": 212,
    "time": "00:14:39,550 --> 00:14:42,870",
    "ja": "個人的には平気にめちゃくちゃドストライクなので勘弁してほしい。"
  },
  {
    "id": 213,
    "time": "00:14:42,870 --> 00:14:45,230",
    "ja": "もう裸切るとか裸切らないとかどうでもいいです。"
  },
  {
    "id": 214,
    "time": "00:14:45,230 --> 00:14:49,030",
    "ja": "この子が画面に映るたびに脳がショートして他のことが考えられないです。"
  },
  {
    "id": 215,
    "time": "00:14:49,030 --> 00:14:51,390",
    "ja": "カービーにしてはやたらいしつなキャラデザだよねー。"
  },
  {
    "id": 216,
    "time": "00:14:51,390 --> 00:14:53,510",
    "ja": "果たして最後まで味方でいてくれるのか、"
  },
  {
    "id": 217,
    "time": "00:14:53,510 --> 00:14:55,830",
    "ja": "そもそも的なのか、なにものなのか、"
  },
  {
    "id": 218,
    "time": "00:14:55,830 --> 00:14:58,350",
    "ja": "そして奥では不思議な祭壇を発見しました。"
  },
  {
    "id": 219,
    "time": "00:14:58,350 --> 00:15:01,030",
    "ja": "ウルトラソードの宝石みたいなのがまつられてる。"
  },
  {
    "id": 220,
    "time": "00:15:01,030 --> 00:15:04,190",
    "ja": "ここにエタイの知れないライフストリームみたいなのが集まってきて、"
  },
  {
    "id": 221,
    "time": "00:15:04,190 --> 00:15:07,270",
    "ja": "ソードカービーの剣に新たな力を引き込んでいるみたいです。"
  },
  {
    "id": 222,
    "time": "00:15:07,270 --> 00:15:10,070",
    "ja": "ここはカービーのコピー能力を強化してくれる最弾?"
  },
  {
    "id": 223,
    "time": "00:15:10,070 --> 00:15:11,710",
    "ja": "一体どういう仕組みなんだろう。"
  },
  {
    "id": 224,
    "time": "00:15:11,710 --> 00:15:14,190",
    "ja": "もしかしたらフィールドでなにかしらの収集アイテムを、"
  },
  {
    "id": 225,
    "time": "00:15:14,190 --> 00:15:16,030",
    "ja": "一定数集めてここを訪れると、"
  },
  {
    "id": 226,
    "time": "00:15:16,030 --> 00:15:18,350",
    "ja": "強化イベントが行われるのかもしれません。"
  },
  {
    "id": 227,
    "time": "00:15:18,350 --> 00:15:22,150",
    "ja": "その内容は、スーパー能力を放出とさせるコピー能力確成形。"
  },
  {
    "id": 228,
    "time": "00:15:22,150 --> 00:15:24,430",
    "ja": "ソードがモナドみたいな変形をしオーラをまとい、"
  },
  {
    "id": 229,
    "time": "00:15:24,430 --> 00:15:26,350",
    "ja": "帽子には古代の模様みたいなのが、"
  },
  {
    "id": 230,
    "time": "00:15:26,350 --> 00:15:28,750",
    "ja": "ほっぺには星マークみたいなのがあしらわれます。"
  },
  {
    "id": 231,
    "time": "00:15:28,750 --> 00:15:32,150",
    "ja": "BGMは必殺スーパー能力のフレーズが使用されるなど、"
  },
  {
    "id": 232,
    "time": "00:15:32,150 --> 00:15:33,630",
    "ja": "どっからどう見ても明らかに、"
  },
  {
    "id": 233,
    "time": "00:15:33,630 --> 00:15:36,030",
    "ja": "ウィーノーウルトラソードを放出とさせてくれます。"
  },
  {
    "id": 234,
    "time": "00:15:36,030 --> 00:15:39,470",
    "ja": "スーパー能力のアイデアまた採用してくれないかなって伝えしてたから、"
  },
  {
    "id": 235,
    "time": "00:15:39,470 --> 00:15:40,910",
    "ja": "帰ってきてくれて嬉しい。"
  },
  {
    "id": 236,
    "time": "00:15:40,910 --> 00:15:42,030",
    "ja": "こういうド派手な技は、"
  },
  {
    "id": 237,
    "time": "00:15:42,030 --> 00:15:45,750",
    "ja": "3Dで思いっきり分回してこそ迫力もパワーアップするってもんだ。"
  },
  {
    "id": 238,
    "time": "00:15:45,750 --> 00:15:48,270",
    "ja": "映像では横切りや縦切りを披露してくれました。"
  },
  {
    "id": 239,
    "time": "00:15:48,270 --> 00:15:50,910",
    "ja": "前回と違い、切るモーションが複数あるようです。"
  },
  {
    "id": 240,
    "time": "00:15:50,910 --> 00:15:53,470",
    "ja": "豪快な一振りで敵を投げ倒せるのはもちろん、"
  },
  {
    "id": 241,
    "time": "00:15:53,470 --> 00:15:56,070",
    "ja": "岩壁を結ぶ腐りや、ぶっと痛い台北なんかも、"
  },
  {
    "id": 242,
    "time": "00:15:56,070 --> 00:15:57,790",
    "ja": "見事に一頭両断できます。"
  },
  {
    "id": 243,
    "time": "00:15:57,790 --> 00:16:00,550",
    "ja": "木を切って新たな道が繋がるよう設計されてるから、"
  },
  {
    "id": 244,
    "time": "00:16:00,550 --> 00:16:03,310",
    "ja": "スーパー能力もドキを使って道を開けるのね。"
  },
  {
    "id": 245,
    "time": "00:16:03,310 --> 00:16:05,110",
    "ja": "果たしてこれは強制パートなのか、"
  },
  {
    "id": 246,
    "time": "00:16:05,110 --> 00:16:07,510",
    "ja": "それとも無視しても進めるようできているのか。"
  },
  {
    "id": 247,
    "time": "00:16:07,510 --> 00:16:09,910",
    "ja": "効果時間はどのくらいか、そもそもあるのか、"
  },
  {
    "id": 248,
    "time": "00:16:09,910 --> 00:16:12,550",
    "ja": "2Dのスーパー能力と同違ってくるのかなど、"
  },
  {
    "id": 249,
    "time": "00:16:12,550 --> 00:16:14,470",
    "ja": "まだ明かされていない情報が多いため、"
  },
  {
    "id": 250,
    "time": "00:16:14,470 --> 00:16:16,310",
    "ja": "いま一前防は捕み切れません。"
  },
  {
    "id": 251,
    "time": "00:16:16,310 --> 00:16:17,590",
    "ja": "ただ確実に言えるのは、"
  },
  {
    "id": 252,
    "time": "00:16:17,590 --> 00:16:21,390",
    "ja": "Pの頃には見られなかったスーパー能力的なものが見られると思います。"
  },
  {
    "id": 253,
    "time": "00:16:21,390 --> 00:16:23,790",
    "ja": "それこそボツになったカッターのS能力とか、"
  },
  {
    "id": 254,
    "time": "00:16:23,790 --> 00:16:25,750",
    "ja": "ホムとかにも用意されてそうですね。"
  },
  {
    "id": 255,
    "time": "00:16:25,750 --> 00:16:27,750",
    "ja": "スイコミやフォーバリを強化してきたけれど、"
  },
  {
    "id": 256,
    "time": "00:16:27,750 --> 00:16:30,510",
    "ja": "今回はコピー能力に再フィーチャーしてくれたんだね。"
  },
  {
    "id": 257,
    "time": "00:16:30,510 --> 00:16:32,030",
    "ja": "これでこそカービーって感じ、"
  },
  {
    "id": 258,
    "time": "00:16:32,030 --> 00:16:34,070",
    "ja": "派手な技が色々ありそうで楽しみ。"
  },
  {
    "id": 259,
    "time": "00:16:34,070 --> 00:16:36,270",
    "ja": "そしてウルトラソード的なものを使うことで、"
  },
  {
    "id": 260,
    "time": "00:16:36,270 --> 00:16:38,230",
    "ja": "この世界を閉ざしている偽りの壁を、"
  },
  {
    "id": 261,
    "time": "00:16:38,230 --> 00:16:39,790",
    "ja": "ブチ破ることができます。"
  },
  {
    "id": 262,
    "time": "00:16:39,790 --> 00:16:41,950",
    "ja": "64時代の3Dアクションを思い出す、"
  },
  {
    "id": 263,
    "time": "00:16:41,950 --> 00:16:44,750",
    "ja": "箱庭外の背景はただの1枚絵になってるのね。"
  },
  {
    "id": 264,
    "time": "00:16:44,750 --> 00:16:48,190",
    "ja": "一体全体この先に何が待っていると言うんだ。"
  },
  {
    "id": 265,
    "time": "00:16:48,190 --> 00:16:49,550",
    "ja": "切り倒したその先には、"
  },
  {
    "id": 266,
    "time": "00:16:49,550 --> 00:16:52,830",
    "ja": "とてもプププランドの景色には見えない光屋が広がっていました。"
  },
  {
    "id": 267,
    "time": "00:16:52,830 --> 00:16:54,630",
    "ja": "地形的にはガール平原っぽい、"
  },
  {
    "id": 268,
    "time": "00:16:54,630 --> 00:16:56,670",
    "ja": "切り立った段階絶壁的な地形たち、"
  },
  {
    "id": 269,
    "time": "00:16:56,670 --> 00:16:59,190",
    "ja": "コピー能力を使えばあの上にも登れるのかな?"
  },
  {
    "id": 270,
    "time": "00:16:59,190 --> 00:17:01,470",
    "ja": "機械的なタワーみたいなのも確認できる、"
  },
  {
    "id": 271,
    "time": "00:17:01,470 --> 00:17:04,230",
    "ja": "何かしらの文明の痕跡が残されているのか?"
  },
  {
    "id": 272,
    "time": "00:17:04,230 --> 00:17:06,830",
    "ja": "星ブロックとか風車台北とかバウム空編とか、"
  },
  {
    "id": 273,
    "time": "00:17:06,830 --> 00:17:09,470",
    "ja": "さっきまでのカービーらしい風景がほぼなくなってる。"
  },
  {
    "id": 274,
    "time": "00:17:09,470 --> 00:17:11,510",
    "ja": "リアリティあって後輩的でミステリアスな、"
  },
  {
    "id": 275,
    "time": "00:17:11,510 --> 00:17:13,630",
    "ja": "まるで異世界に来てしまった気分だよ。"
  },
  {
    "id": 276,
    "time": "00:17:13,630 --> 00:17:16,270",
    "ja": "上空を見上げると、謎のフリュートウが浮いています。"
  },
  {
    "id": 277,
    "time": "00:17:16,270 --> 00:17:17,830",
    "ja": "ドフラミンゴのトリカゴみたいに、"
  },
  {
    "id": 278,
    "time": "00:17:17,830 --> 00:17:20,750",
    "ja": "何回とのようなものが各地に伸びて囲っていますね。"
  },
  {
    "id": 279,
    "time": "00:17:20,750 --> 00:17:23,870",
    "ja": "なんだこれ、この糸の先にステージが用意されてるとか?"
  },
  {
    "id": 280,
    "time": "00:17:23,870 --> 00:17:25,950",
    "ja": "本数数えると15本くらいあるけれど、"
  },
  {
    "id": 281,
    "time": "00:17:25,950 --> 00:17:28,230",
    "ja": "さすが25エリアは多すぎるからなさそう。"
  },
  {
    "id": 282,
    "time": "00:17:28,230 --> 00:17:29,710",
    "ja": "オープンワールドでは大切な、"
  },
  {
    "id": 283,
    "time": "00:17:29,710 --> 00:17:31,830",
    "ja": "目的地への目印になっていそうです。"
  },
  {
    "id": 284,
    "time": "00:17:31,830 --> 00:17:33,630",
    "ja": "道に迷った時は空を見上げて、"
  },
  {
    "id": 285,
    "time": "00:17:33,630 --> 00:17:36,390",
    "ja": "糸の伸びる先へ向かって進めばいい、ですからね。"
  },
  {
    "id": 286,
    "time": "00:17:36,390 --> 00:17:38,830",
    "ja": "いずれはあの島がラストダンジョンになるのかもな。"
  },
  {
    "id": 287,
    "time": "00:17:38,830 --> 00:17:42,350",
    "ja": "そしてタイトルロゴの下の方には、謎のモルドゲイラが踊っています。"
  },
  {
    "id": 288,
    "time": "00:17:42,350 --> 00:17:44,590",
    "ja": "見た感じセビもチーフの機械生命体?"
  },
  {
    "id": 289,
    "time": "00:17:44,590 --> 00:17:46,270",
    "ja": "胴体のエメラルドカラー部分が、"
  },
  {
    "id": 290,
    "time": "00:17:46,270 --> 00:17:48,190",
    "ja": "明らかに弱点だとわかるデザイン。"
  },
  {
    "id": 291,
    "time": "00:17:48,190 --> 00:17:50,790",
    "ja": "こいつもこの先で立ち裸るボスなんでしょうかね。"
  },
  {
    "id": 292,
    "time": "00:17:50,790 --> 00:17:51,630",
    "ja": "意味深です。"
  },
  {
    "id": 293,
    "time": "00:17:51,630 --> 00:17:52,750",
    "ja": "そしてタイトルロゴは、"
  },
  {
    "id": 294,
    "time": "00:17:52,750 --> 00:17:54,310",
    "ja": "いつものボップな雰囲気よりも、"
  },
  {
    "id": 295,
    "time": "00:17:54,310 --> 00:17:56,430",
    "ja": "どこかシリアスな雰囲気になっています。"
  },
  {
    "id": 296,
    "time": "00:17:56,430 --> 00:17:57,790",
    "ja": "ワールドビヨンドの文字にも、"
  },
  {
    "id": 297,
    "time": "00:17:57,790 --> 00:17:59,710",
    "ja": "謎の文様があしらわれていますし。"
  },
  {
    "id": 298,
    "time": "00:17:59,710 --> 00:18:01,630",
    "ja": "背後にはウルトラソードモドキカビーの、"
  },
  {
    "id": 299,
    "time": "00:18:01,630 --> 00:18:03,190",
    "ja": "ほっぺに付いていたマークが、"
  },
  {
    "id": 300,
    "time": "00:18:03,190 --> 00:18:04,390",
    "ja": "今回のテーマカラーは、"
  },
  {
    "id": 301,
    "time": "00:18:04,390 --> 00:18:05,910",
    "ja": "エメラルドグリーンなのかな?"
  },
  {
    "id": 302,
    "time": "00:18:05,910 --> 00:18:06,750",
    "ja": "色合いにはイヤシ、"
  },
  {
    "id": 303,
    "time": "00:18:06,750 --> 00:18:07,350",
    "ja": "イツクシミ、"
  },
  {
    "id": 304,
    "time": "00:18:07,350 --> 00:18:07,790",
    "ja": "冷静、"
  },
  {
    "id": 305,
    "time": "00:18:07,790 --> 00:18:09,350",
    "ja": "自然との共和を意味するけど、"
  },
  {
    "id": 306,
    "time": "00:18:09,350 --> 00:18:11,630",
    "ja": "この色がストーリーにどうか変わってくるのか。"
  },
  {
    "id": 307,
    "time": "00:18:11,630 --> 00:18:14,670",
    "ja": "最後の発売時期が表示される画面にもディスカバリーが、"
  },
  {
    "id": 308,
    "time": "00:18:14,670 --> 00:18:15,950",
    "ja": "トークの方ニュースラと、"
  },
  {
    "id": 309,
    "time": "00:18:15,950 --> 00:18:18,230",
    "ja": "野生のギガンとエッチ君がうろついています。"
  },
  {
    "id": 310,
    "time": "00:18:18,230 --> 00:18:19,430",
    "ja": "この子毎回いるねー。"
  },
  {
    "id": 311,
    "time": "00:18:19,430 --> 00:18:21,510",
    "ja": "中ボス戦は今回もあるというわけだ。"
  },
  {
    "id": 312,
    "time": "00:18:21,510 --> 00:18:22,710",
    "ja": "これの何がヤバいって、"
  },
  {
    "id": 313,
    "time": "00:18:22,710 --> 00:18:25,310",
    "ja": "野生でその辺のフィールドオールをついてることですよ。"
  },
  {
    "id": 314,
    "time": "00:18:25,310 --> 00:18:27,830",
    "ja": "今までの中ボスは近づくまで姿を表さず、"
  },
  {
    "id": 315,
    "time": "00:18:27,830 --> 00:18:30,430",
    "ja": "カービーがエリア内に入ってから出現していました。"
  },
  {
    "id": 316,
    "time": "00:18:30,430 --> 00:18:32,990",
    "ja": "だからこそ逃げられない調整バトルだったんですが、"
  },
  {
    "id": 317,
    "time": "00:18:32,990 --> 00:18:34,630",
    "ja": "今回は鼻から見えています。"
  },
  {
    "id": 318,
    "time": "00:18:34,630 --> 00:18:36,350",
    "ja": "叫ようと思ったら叫れそう。"
  },
  {
    "id": 319,
    "time": "00:18:36,350 --> 00:18:38,870",
    "ja": "もしかしたら中ボス戦は調整ではないのかもね、"
  },
  {
    "id": 320,
    "time": "00:18:38,870 --> 00:18:44,230",
    "ja": "自由度高くて無視できるのかも。"
  },
  {
    "id": 321,
    "time": "00:18:44,230 --> 00:18:45,790",
    "ja": "また意気外が増えてしまった、"
  },
  {
    "id": 322,
    "time": "00:18:45,790 --> 00:18:48,750",
    "ja": "ゲームを愛していると毎年のように幸せがやってきます。"
  },
  {
    "id": 323,
    "time": "00:18:48,750 --> 00:18:50,310",
    "ja": "子供の頃から夢見ていた、"
  },
  {
    "id": 324,
    "time": "00:18:50,310 --> 00:18:53,030",
    "ja": "広大なカービーワールドを気ままに走り回る体験が、"
  },
  {
    "id": 325,
    "time": "00:18:53,030 --> 00:18:54,750",
    "ja": "ついに叶いそうで感無料です。"
  },
  {
    "id": 326,
    "time": "00:18:54,750 --> 00:18:56,710",
    "ja": "まさか3D本編に作目にして、"
  },
  {
    "id": 327,
    "time": "00:18:56,710 --> 00:18:58,710",
    "ja": "ここまでの進化を遂げてくるとはなー。"
  },
  {
    "id": 328,
    "time": "00:18:58,710 --> 00:19:01,150",
    "ja": "まだまだ隠している情報がいっぱいありそうだし、"
  },
  {
    "id": 329,
    "time": "00:19:01,150 --> 00:19:03,590",
    "ja": "これからの続報や盛り上がりに期待膨らむよ。"
  },
  {
    "id": 330,
    "time": "00:19:03,590 --> 00:19:06,030",
    "ja": "というわけでまたカービーの動画を増やしていきます。"
  },
  {
    "id": 331,
    "time": "00:19:06,030 --> 00:19:08,630",
    "ja": "でもエアライダー時期みたいにカービーオンリーではないです。"
  },
  {
    "id": 332,
    "time": "00:19:08,630 --> 00:19:11,350",
    "ja": "他のゲームでも取り上げたい奴や魔法とありますからね。"
  },
  {
    "id": 333,
    "time": "00:19:11,350 --> 00:19:14,030",
    "ja": "多すぎてネタギレの心配ないどころか香水だよ。"
  },
  {
    "id": 334,
    "time": "00:19:14,030 --> 00:19:16,430",
    "ja": "ゼルダ、ロックマン、悪魔状、メトロイドまで、"
  },
  {
    "id": 335,
    "time": "00:19:16,430 --> 00:19:19,670",
    "ja": "ウプヌシの押し芸新作がなぜか過剰供給されてるのくさ。"
  },
  {
    "id": 336,
    "time": "00:19:19,670 --> 00:19:22,910",
    "ja": "だからカービーと同時並行でたゲイ動画出すことを許してください。"
  },
  {
    "id": 337,
    "time": "00:19:22,910 --> 00:19:24,790",
    "ja": "みたい人だけ見てくれればいいです。"
  },
  {
    "id": 338,
    "time": "00:19:24,790 --> 00:19:27,950",
    "ja": "とはいえ、僕にとってカービーは、いつか帰るところなんです。"
  },
  {
    "id": 339,
    "time": "00:19:27,950 --> 00:19:30,430",
    "ja": "他のゲームも大好きでより満ちたくさんするけれど、"
  },
  {
    "id": 340,
    "time": "00:19:30,430 --> 00:19:32,670",
    "ja": "やっぱり一番嬉しいのは桃玉ですよ。"
  },
  {
    "id": 341,
    "time": "00:19:32,670 --> 00:19:36,870",
    "ja": "この顔見るだけで悲鳴上がるし体は震えるしテンション上がるし体調は崩します。"
  },
  {
    "id": 342,
    "time": "00:19:36,870 --> 00:19:39,630",
    "ja": "僕は何のゲームでも好きになったらとことないしますが、"
  },
  {
    "id": 343,
    "time": "00:19:39,630 --> 00:19:41,430",
    "ja": "やっぱカービーだけは特別です。"
  },
  {
    "id": 344,
    "time": "00:19:41,430 --> 00:19:44,190",
    "ja": "これからもまたいろいろ動画出していくんでお楽しみに。"
  },
  {
    "id": 345,
    "time": "00:19:44,190 --> 00:19:45,590",
    "ja": "ご視聴ありがとうございました。"
  }
]